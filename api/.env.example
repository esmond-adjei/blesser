# Blesser API and worker settings. Every value shown is the default unless noted.

# --- Agent model (required for scans) ---
# anthropic | openai | ollama | gemini | openai-compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# Only for ollama / openai-compatible / a proxy.
LLM_BASE_URL=
# Hosts (host or host:port) LLM_BASE_URL may reach over plain http or a private address.
ALLOWED_PROVIDER_HOSTS=

# --- Web search (required for scans) ---
# Ordered chain, e.g. "tavily,brave". Keyless duckduckgo is opt-in only.
SEARCH_PROVIDERS=
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Opportunities ---
# What one discovery task, and one scan, may save.
MAX_OPPORTUNITIES_PER_TASK=15
MAX_OPPORTUNITIES_PER_RUN=40
# Region a scan targets when none is given.
OPPORTUNITY_DEFAULT_REGION=Ghana
# Agent saves are grounded in a fetched page and publish at once; false holds
# them for an ops admin to publish.
OPPORTUNITY_AUTO_PUBLISH=true
# Scheduled refresh: every N hours the worker scans every category as this
# existing account. Empty email or 0 = off.
OPPORTUNITY_SWEEP_EMAIL=
OPPORTUNITY_SWEEP_HOURS=0
# Comma-separated emails that may moderate the catalogue (once verified).
OPS_ADMIN_EMAILS=

# --- Agent budgets ---
MAX_AGENT_TURNS=40
MAX_TASK_ATTEMPTS=3
TRACE_RETENTION_DAYS=90

# --- Database and HTTP ---
DATABASE_URL=postgresql+asyncpg://blesser:blesser@localhost:5432/blesser
# "*" for dev; in production the web app's origin, e.g. https://blesser.example.com
CORS_ORIGINS=*

# --- Auth (AUTH_SECRET is required in production) ---
AUTH_SECRET=
# Google sign-in shows when both are set. Redirect URI: {APP_BASE_URL}/auth/callback/google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# --- Email (docs/email.md) ---
# "console" prints messages to the log; "smtp" sends them.
MAIL_BACKEND=console
MAIL_FROM=Blesser <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Public URL of the web app, for links in emails and calendars.
APP_BASE_URL=http://localhost:5173
# Public origin of the API for calendar subscription links; empty = APP_BASE_URL
# (right when the web app proxies /api).
PUBLIC_API_URL=

# --- Browser push (docs/notifications.md); off while either key is empty ---
# Generate with: make vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
