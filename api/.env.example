# --- Bring-your-own-model: agent LLM ---
# LLM_PROVIDER: anthropic | openai | ollama | gemini | openai-compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
# A smaller model (same provider and endpoint) for short single-purpose
# calls: the code-first save of a likely match and email drafts. Empty =
# LLM_MODEL for everything. Runs on someone's own model aren't affected.
LLM_SMALL_MODEL=

# Single key/endpoint for the agent LLM, every provider.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=256000
# Anthropic prompt caching on tools, system prompt and the history so far
# (later turns read them at a tenth of the price). OpenAI and Gemini cache
# on their own.
LLM_PROMPT_CACHE=true
# Hosts a user's own provider base URL may reach over http or on a private
# address (host or host:port, comma-separated), e.g. a self-hosted vLLM.
# Everything else must be public https. Empty = public https only.
ALLOWED_PROVIDER_HOSTS=

# --- Bring-your-own-model: embeddings ---
# EMBEDDING_PROVIDER: voyage | openai | ollama | gemini | openai-compatible | local
#   local = TF-IDF fallback, zero keys, dev/testing only.
# Single key/endpoint for embeddings, every provider. Voyage AI key from
# https://www.voyageai.com/ (Anthropic's recommended embeddings partner).
# If left blank, embeddings fall back to a crude TF-IDF similarity so the
# pipeline still runs end to end during development.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Web search provider for school/program/faculty-page discovery.
# Any provider works as long as you implement the call in services/web.py.
# Tavily and Brave Search both have generous free tiers and are built for
# this kind of agentic lookup (cleaner results than scraping raw SERPs).
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily

# DB connection. Postgres only: start it with `docker compose up -d db`
# (from the repo root), then this URL just works.
DATABASE_URL=postgresql+asyncpg://graduator:graduator@localhost:5432/graduator

# Postgres pool: keep above worker concurrency plus housekeeping loops.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Anti-runaway budgets: max new entities one agent task may save.
# Enforced in dispatch(), per task (not per run). Each save_program also
# enqueues a research_professor task, so cap discovery to keep the queue
# from exploding.
MAX_PROGRAMS_PER_TASK=12
MAX_PROFESSORS_PER_TASK=10
MAX_DRAFTS_PER_TASK=3
MAX_AGENT_TURNS=40

# TypeSafe semantic judgments (opt-in). When the deterministic rationale
# check fails, Jev re-judges whether the papers support the rationale
# (tolerates paraphrase the substring gate rejects). Needs TYPESAFE_API_KEY
# from https://console.typesafe.ai/. Off by default: zero behavior change.
TYPESAFE_API_KEY=
TYPESAFE_RATIONALE_CHECK=false
# Jev picks between same-name authors at a school, so the professor skips
# the full agent loop.
TYPESAFE_AUTHOR_PICK=false
# Jev rates how well a professor's papers fit the interests: shown in Check
# match, and a confident fit keeps a professor the similarity would drop.
TYPESAFE_FIT_RATING=false
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_AUTO_ACCEPT=0.8

# Progress floor: bounces empty finishes back to work instead of accepting
# a task that saved nothing. Bounded - the summary stands after this many.
MAX_EMPTY_FINISH_NUDGES=2

# Scaling + reliability.
# Run-level cap: total candidates one run may accumulate across all tasks.
MAX_CANDIDATES_PER_RUN=30
# Fan-out cap: max professor-research tasks one spawn call may queue.
MAX_SPAWN_PER_CALL=20
# Convergence caps, overridable per run at creation (max_programs,
# max_professors, max_professors_per_program). Together they bound total
# work: programs x (1 supervisor + N narrow tasks) + drafts.
MAX_PROGRAMS_PER_RUN=10
MAX_PROFESSORS_PER_PROGRAM=5
# Narrow tasks a run may research in total, as a multiple of its candidate
# cap (room for professors who turn out not to match).
RESEARCH_BUDGET_FACTOR=2.5
# Model turns for a programme's admissions step (find, read, save).
INDEX_APPLICATION_MAX_TURNS=6
# Stop releasing a programme's leads once its last this-many researched
# professors all scored as unrelated (leads are ranked by topic). Professors
# the student added and lookups that failed never count. 0 = off.
PROGRAMME_MISS_STREAK=3
# Most calls per tool in one professor task; past it the tool is refused.
NARROW_TOOL_CAPS={"find_openalex_author": 3, "get_author_works": 4, "fetch_page": 4, "search_web": 4}
# Narrow tasks look professors up and score them in code first; only a
# likely match costs a (short) model call.
DETERMINISTIC_RESEARCH=true
# Context compaction: tool results older than this many turns are replaced
# with a marker before calling the provider. <=0 disables.
MAX_TOOL_RESULT_AGE_TURNS=2
# Compaction moves in blocks of this many turns, so the history's prefix
# stays identical between moves and prompt caches can serve it. 1 = every turn.
COMPACTION_BLOCK_TURNS=3
# fetch_page payload cap (faculty listings need names + links, not essays).
FETCH_MAX_CHARS=3000
# What a search shows the model: this many results, each snippet cut to this
# many characters (a page worth reading is a fetch_page away).
SEARCH_RESULTS_FOR_MODEL=5
SEARCH_SNIPPET_CHARS=200
# get_author_works shows the research agent this much of each abstract
# unless it asks for full=true; scoring always reads the full text.
WORKS_ABSTRACT_CHARS=300
# Raw bytes read per page before extraction. fetch_page only reaches public
# http(s) addresses and re-checks every redirect (api/core/egress.py).
FETCH_MAX_BYTES=2000000
# Stale-task reaper: a running task is requeued (resuming from its
# checkpoint) once the worker that claimed it stops heartbeating. This TTL
# only applies to rows claimed before leases existed.
STALE_TASK_MINUTES=15
# Per-request model timeout in seconds (SDKs retry twice); keep it well
# under the stale window.
LLM_TIMEOUT_SECONDS=120
# A model turn that fails transiently (timeout, connection, 429/5xx) is
# retried with exponential backoff; a task still failing is requeued from
# its checkpoint until it has been claimed MAX_TASK_ATTEMPTS times. Local
# models (Ollama) shared by several workers may also need a larger
# LLM_TIMEOUT_SECONDS.
LLM_TURN_RETRIES=2
# Model calls one worker process sends to a backend at once (0 = no cap).
# Calls past the cap wait for a slot without using up their deadline.
# Ollama works through OLLAMA_NUM_PARALLEL requests at a time and queues
# the rest, so it is capped at 2 by default; match that setting (see
# docs/deployment.md for sizing the server's context and parallel slots).
LLM_MAX_CONCURRENCY=0
OLLAMA_MAX_CONCURRENCY=2
LLM_RETRY_BACKOFF_SECONDS=10
MAX_TASK_ATTEMPTS=3
# Worker heartbeat: seconds between liveness writes. Shown stale beyond 4x.
WORKER_HEARTBEAT_SECONDS=15
# Idle claim backstop. Loops wake on an enqueue notification (LISTEN), so
# this only bounds how long a missed wake can stall the queue.
WORKER_IDLE_POLL_SECONDS=5.0

# Live event feed (SSE).
# Sweep backstop for the run feed. Write sites push over LISTEN/NOTIFY, so
# this only covers missed wakes, direct DB writes, and a LISTEN that never
# attached. Every sweep is a recheck per connected stream - keep it slow.
SSE_SWEEP_SECONDS=10.0
# Cap on concurrent streams. Each holds one LISTEN connection outside the
# pool, so budget this against Postgres max_connections together with
# DB_POOL_SIZE + DB_MAX_OVERFLOW for the api and for each worker.
SSE_MAX_STREAMS=32
# Max tool-call entries carried in one live-trace frame.
SSE_TRACE_MAX_EVENTS=60

# Agent execution tuning.
# Read-only tools (search/fetch/OpenAlex) in one assistant turn run
# concurrently up to this width. DB-writing tools always stay serial: they
# share one session and the per-task save budgets.
AGENT_PARALLEL_TOOL_CALLS=6
# Remote-politeness ceilings, shared process-wide across worker loops.
HTTP_SEARCH_CONCURRENCY=5
HTTP_FETCH_CONCURRENCY=8
OPENALEX_CONCURRENCY=4

# Health: failures older than this stop raising the "may have stalled"
# banner, so one historical failure doesn't pin it on permanently.
HEALTH_ERROR_WINDOW_MINUTES=60

# CORS for split deploys (webapp on its own origin). "*" = open dev default;
# production: comma-separated origins, e.g. https://graduator.example.com
CORS_ORIGINS=*

# CV editor (surgical DOCX editing). Local append-only layout cv/{doc}/...
# under this dir; swap api/cv/storage.py for S3 later without touching
# the service layer. Uploads over this size are rejected before parsing.
# Must be persistent: docker compose pins it to /app/cv_storage on the
# graduator_cv_storage volume. Elsewhere, use an absolute path on a mount.
CV_STORAGE_DIR=cv_storage
CV_MAX_UPLOAD_BYTES=10485760

# --- Transactional email (password reset, verification); docs/email.md ---
# MAIL_BACKEND=console prints mail to the API's stderr (dev); smtp relays.
MAIL_BACKEND=console
MAIL_FROM=Graduator <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:5173

# --- Notifications (docs/notifications.md) ---
# Browser push (Web Push, VAPID). Push stays off, with a log line, while
# either key is empty; the inbox and email still work. Generate a pair
# once per deployment with `make vapid-keys` (changing it drops every
# browser's subscription). The subject is a contact for push services:
# mailto:you@yourdomain or an https URL; MAIL_FROM's address otherwise.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Push + email sends per account per hour; the rest stay in the inbox.
NOTIFICATION_HOURLY_CAP=20

# --- Sign in with Google (docs/sign-in-providers.md); button hidden when unset ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# --- Metering (api/metering); ops view at GET /api/ops/usage or `make usage-report` ---
USAGE_RETENTION_DAYS=400
OPS_ADMIN_EMAILS=

# --- Plans (docs/plans.md). Off during beta: every feature, no quotas ---
BILLING_ENFORCED=false
# Development only: each account can switch its own plan in Settings >
# Usage, and that plan applies even with BILLING_ENFORCED=false, to try
# feature gates and quotas per plan. Never on where real users sign up.
BILLING_PLAN_SWITCH=false
# Who takes payment at checkout. Nothing yet: leave empty. "simulated" is
# a development-only local test checkout with test cards (4242 4242 4242
# 4242 succeeds, 4000 0000 0000 0002 is declined), no real charge; it also
# requires BILLING_PLAN_SWITCH=true and must never serve real users.
BILLING_PROVIDER=
# Operator model key (LLM_API_KEY), the "Auto" model every account
# defaults to: switch it off, require a verified email, and cap each
# account's daily tokens on it (0 = no cap; counts the account's tokens on
# any model). With BILLING_ENFORCED, each plan's allowance replaces the cap
# (api/billing/plans.py); Beta is exempt from both daily ceilings.
ALLOW_SYSTEM_MODEL=true
SYSTEM_MODEL_REQUIRES_VERIFIED_EMAIL=true
SYSTEM_MODEL_DAILY_TOKENS=1000000
# Per-account daily calls to the operator's search, embedding and
# TypeSafe keys, counted together (0 = no cap).
SYSTEM_DAILY_TOOL_CALLS=2000

# --- Tool fallbacks (docs/fallbacks.md) ---
# DuckDuckGo is a keyless HTML scrape its terms likely forbid: opt-in only,
# add ",duckduckgo" here if you accept that.
SEARCH_PROVIDERS=tavily,brave
TAVILY_API_KEY=
BRAVE_API_KEY=
FETCH_FALLBACKS=archive

# --- Data caches (per worker process, public data only; 0 = off) ---
# An identical query this recent is answered from cache (no search quota).
SEARCH_REUSE_SECONDS=3600
# Extracted pages: offset reads, other tasks, later runs at the same school.
FETCH_CACHE_SECONDS=21600
OPENALEX_CACHE_SECONDS=86400
# OpenAlex responses kept in Postgres too, shared by the API and workers and
# across restarts (days; school author lists and institutions use the long
# TTL). 0 = off.
OPENALEX_DB_CACHE_DAYS=7
OPENALEX_DB_CACHE_LONG_DAYS=30
# Find professors in their school's author list (pages of 200, list calls at
# a tenth of a search's price) before searching by name. 0 = always search.
OPENALEX_ROSTER_PAGES=5
# Faculty lists mostly in code: the department page is read by one model call
# and a list of at least ROSTER_MIN_NAMES names is queued without the
# supervisor's agent loop (0 = off), then kept FACULTY_ROSTER_DAYS for repeat
# programmes. ROSTER_PAGE_CHARS of a page go to that call. When no page can
# be read, authors OpenAlex places at the school with ROSTER_SEED_MIN_WORKS
# works there on the topic are queued instead.
ROSTER_MIN_NAMES=3
FACULTY_ROSTER_DAYS=30
ROSTER_PAGE_CHARS=15000
ROSTER_SEED_MIN_WORKS=2
# Model turns for the supervisor's agent loop when the faculty list could not
# be read in code (a name-extraction job, not MAX_AGENT_TURNS).
SUPERVISOR_MAX_TURNS=15
# Every professor a run looks up (OpenAlex author and works, match or not) is
# kept in the account's own index; a later run at the same school reuses an
# entry up to PROFESSOR_INDEX_DAYS old instead of looking them up again.
# 0 = off (nothing kept or reused).
PROFESSOR_INDEX_DAYS=30
EMBEDDING_CACHE_SECONDS=604800

# --- Secrets at rest (docs/production-checklist.md) ---
# Fernet key for provider API keys; derived from AUTH_SECRET when unset.
SECRETS_KEY=

# --- Compliance (docs/data-handling.md) ---
# Page fetches identify themselves (no browser impersonation) and honour
# robots.txt for this agent's product token.
FETCH_USER_AGENT="GraduatorBot/0.4 (research assistant; +https://github.com/esmond-adjei/graduator)"
RESPECT_ROBOTS_TXT=true
# OpenAlex polite-pool contact (your ops address). Expected in every
# deployment: without it requests share the common pool and get more 429s,
# and the API and worker log a warning at startup.
OPENALEX_MAILTO=
# OpenAlex API key. Without one, everything on the server's IP shares a
# free budget of about $0.10/day (~100 author searches), then every lookup
# fails with 429 until midnight UTC. A free key has its own ~$1/day:
#   curl -X POST https://api.openalex.org/api-keys -H 'Content-Type: application/json' \
#     -d '{"email": "ops@example.com"}'   # then confirm the email
OPENALEX_API_KEY=
# Professor tasks that waited out a used-up OpenAlex budget resume spread
# over this many seconds after the reset.
OPENALEX_RESUME_SPREAD_SECONDS=600
# When OpenAlex rejects the API key (401/403), professor tasks wait and the
# key is tried again this often, so a fixed key works without a restart.
OPENALEX_AUTH_RECHECK_SECONDS=300
# Other sources that verify professors (docs/verification-sources.md): ORCID /
# DBLP ids linked on faculty pages (before OpenAlex), then DBLP (computing
# fields), NIH RePORTER and NSF awards (US schools) and ORCID (any field) when
# OpenAlex has nobody at the school or is down. semantic_scholar adds
# abstracts to ORCID and DBLP works. Remove a name to switch that source off.
VERIFICATION_SOURCES=faculty_page,dblp,nih,nsf,orcid,semantic_scholar
SOURCE_TIMEOUT_SECONDS=10
# Least seconds between two requests to one source (JSON), the longest a
# request may queue for its slot, and how long a failing source is skipped.
SOURCE_MIN_INTERVAL_SECONDS={"dblp": 1.0, "nih": 1.0, "nsf": 1.0, "orcid": 0.5, "semantic_scholar": 1.1}
# Optional Semantic Scholar key: its own rate limit instead of the shared one.
SEMANTIC_SCHOLAR_API_KEY=
SOURCE_MAX_QUEUE_SECONDS=15
SOURCE_OUTAGE_SECONDS=300
SOURCE_CACHE_SECONDS=86400
# Agent traces of finished tasks are deleted after this many days.
TRACE_RETENTION_DAYS=90
# Bump with the webapp's TERMS_VERSION when /terms or /privacy change.
TERMS_VERSION=2026-10-15
