---
import { buttonVariants } from "@blesser/ui"
import { LinkEmptyState } from "../components/States"
import notFound from "@blesser/ui/illustrations/spot-not-found.webp"
import Base from "../layouts/Base.astro"
import CardGrid from "../components/CardGrid.astro"
import ClientListing from "../components/ClientListing.astro"
import Pagination from "../components/Pagination.astro"
import NotFound from "../components/NotFound.astro"
import PageHeader from "../components/PageHeader.astro"
import ApiErrorSection from "../components/ApiError.astro"
import { ArrowRightIcon } from "../components/icons"
import { ApiError, allOpportunities, api, settle } from "../lib/api"
import { STATIC_BUILD, registerUrl, withBase } from "../lib/config"
import { plural } from "../lib/format"
import { landingFor, CATEGORY_LANDINGS, KIND_LANDINGS, LANDINGS } from "../lib/landings"
import { PAGE_SIZE, readFilters } from "../lib/listing"

export const getStaticPaths = () => LANDINGS.map((l) => ({ params: { landing: l.slug } }))

const landing = landingFor(Astro.params.landing ?? "")
const { page } = readFilters(Astro.url.searchParams)
const result = landing
  ? await settle(
      STATIC_BUILD
        ? allOpportunities(landing.filter)
        : api.opportunities({ ...landing.filter, limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE }),
    )
  : null
if (!landing) Astro.response.status = 404
else if (result instanceof ApiError && !STATIC_BUILD) Astro.response.status = 503

const listHref = withBase(landing ? `/opportunities?${new URLSearchParams(landing.filter).toString()}` : "/opportunities")
const emptyState = {
  title: "Nothing open here right now",
  description: "New opportunities arrive every day. Create an account and we'll tell you when they do.",
  actions: [{ href: withBase("/opportunities"), label: "See everything open" }],
}
const siblings = landing ? ("category" in landing.filter ? CATEGORY_LANDINGS : KIND_LANDINGS.slice(0, 6)).filter((l) => l.slug !== landing.slug) : []
---

{
  !landing ? (
    <Base title="Not found" noindex>
      <NotFound />
    </Base>
  ) : (
    <Base title={landing.title} description={`${landing.intro} Open now in Ghana, checked against the official page.`} path={`/${landing.slug}`} noindex={page > 1}>
      <PageHeader
        big
        eyebrow={"category" in landing.filter ? "Who it's for" : "Opportunities"}
        title={landing.title}
        description={landing.intro}
        tone={"category" in landing.filter ? "forest" : "sun"}
        illustration={landing.illustration}
      >
        <div slot="meta" class="mt-6 flex flex-wrap gap-3">
          <a href={listHref} class={buttonVariants({ variant: "brand" })}>Filter and search</a>
          <a href={registerUrl()} class={buttonVariants({ variant: "secondary" })}>Create account to track</a>
        </div>
      </PageHeader>

      <section aria-labelledby="open-now" class="site-container py-8">
        {result instanceof ApiError || !result ? (
          <ApiErrorSection />
        ) : result.items.length === 0 ? (
          <LinkEmptyState illustration={notFound.src} {...emptyState} />
        ) : (
          <>
            <h2 id="open-now" class="m-0 mb-4 type-title-2 text-ink">
              Open now <span class="text-ink-tertiary">· <span data-count>{plural(result.total, "opportunity", "opportunities")}</span></span>
            </h2>
            {STATIC_BUILD ? (
              <ClientListing items={result.items} empty={emptyState} />
            ) : (
              <>
                <CardGrid items={result.items} />
                <Pagination total={result.total} page={page} pageSize={PAGE_SIZE} />
              </>
            )}
          </>
        )}
      </section>

      {siblings.length > 0 && (
        <nav aria-label="More to explore" class="site-container py-8">
          <h2 class="m-0 mb-4 text-headline text-ink">More to explore</h2>
          <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
            {siblings.map((l) => (
              <li>
                <a href={withBase(`/${l.slug}`)} class={buttonVariants({ variant: "secondary", size: "sm" })}>
                  {l.title}
                  <ArrowRightIcon />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </Base>
  )
}
