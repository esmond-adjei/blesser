---
import Base from "../../layouts/Base.astro"
import CardGrid from "../../components/CardGrid.astro"
import NotFound from "../../components/NotFound.astro"
import PageHeader from "../../components/PageHeader.astro"
import ApiErrorSection from "../../components/ApiError.astro"
import { LinkEmptyState } from "../../components/States"
import { ApiError, api, settle, type PublicCollection } from "../../lib/api"
import { STATIC_BUILD, withBase } from "../../lib/config"
import { plural } from "../../lib/format"

export async function getStaticPaths() {
  const collections = await settle(api.collections())
  return collections instanceof ApiError ? [] : collections.map((c) => ({ params: { slug: c.slug }, props: { collection: c } }))
}

const slug = Astro.params.slug ?? ""
const result = (Astro.props as { collection?: PublicCollection }).collection ?? (await settle(api.collection(slug)))
const collection = result instanceof ApiError ? null : result
const missing = result instanceof ApiError && result.notFound
if (missing) Astro.response.status = 404
else if (!collection && !STATIC_BUILD) Astro.response.status = 503
const items = collection?.items.filter((o) => !o.closed) ?? []
---

<Base
  title={collection ? collection.title : missing ? "Not found" : "Collections unavailable"}
  description={collection?.intro || undefined}
  path={`/collections/${encodeURIComponent(slug)}`}
  noindex={!collection}
>
  {missing && <NotFound title="We couldn't find that collection" />}
  {!missing && !collection && <ApiErrorSection />}
  {
    collection && (
      <>
      <PageHeader title={collection.title} description={collection.intro || undefined} tone="sun">
        <p slot="meta" class="m-0 mt-4 text-callout font-semibold text-sun-ink">{plural(items.length, "opportunity", "opportunities")} open</p>
      </PageHeader>
      <div class="site-container py-10">
        <div>
          {items.length > 0 ? (
            <CardGrid items={items} />
          ) : (
            <LinkEmptyState
              title="Everything in this collection has closed"
              description="Keep going, more are coming. See what's open now."
              actions={[{ href: withBase("/opportunities"), label: "Browse opportunities" }]}
            />
          )}
        </div>
      </div>
      </>
    )
  }
</Base>
