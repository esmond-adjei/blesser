---
import { Chip, Countdown, buttonVariants, cn } from "@blesser/ui"
import hero from "@blesser/ui/illustrations/site-hero.webp"
import hero768 from "@blesser/ui/illustrations/site-hero-768.webp"
import startups768 from "@blesser/ui/illustrations/site-startups-768.webp"
import researchers768 from "@blesser/ui/illustrations/site-researchers-768.webp"
import students768 from "@blesser/ui/illustrations/site-students-768.webp"
import path from "@blesser/ui/illustrations/site-path.webp"
import path768 from "@blesser/ui/illustrations/site-path-768.webp"
import community from "@blesser/ui/illustrations/site-community.webp"
import community768 from "@blesser/ui/illustrations/site-community-768.webp"
import scanning from "@blesser/ui/illustrations/spot-scanning.webp"
import Base from "../layouts/Base.astro"
import CardGrid from "../components/CardGrid.astro"
import Panel from "../components/Panel.astro"
import FeatureSplit from "../components/FeatureSplit.astro"
import Illustration from "../components/Illustration.astro"
import ApiErrorSection from "../components/ApiError.astro"
import { ApiError, api, settle, type Announcement } from "../lib/api"
import { STATIC_BUILD, loginUrl, registerUrl, siteUrl, withBase } from "../lib/config"
import { plural } from "../lib/format"
import { wholeRows } from "../lib/listing"
import { organizationLd } from "../lib/seo"

const [siteData, collections, recent] = await Promise.all([
  settle(api.site()),
  settle(api.collections()),
  settle(api.opportunities({ sort: "new", limit: 24 })),
])
const failed = siteData instanceof ApiError
if (failed && !STATIC_BUILD) Astro.response.status = 503

const content = failed ? null : siteData.content
const heroTitle = content?.hero_title || "Find your next opportunity"
const heroSubtitle =
  content?.hero_subtitle ||
  "Grants, fellowships, scholarships and accelerators for startups, researchers and students in Ghana, checked against the official page."

const today = new Date().toISOString().slice(0, 10)
const isActive = (a: Announcement | null | undefined): a is Announcement =>
  !!a?.text && (!a.starts_on || a.starts_on <= today) && (!a.ends_on || a.ends_on >= today)
const announcement = isActive(content?.announcement) ? content.announcement : null

// Closing soon skips what Featured already shows.
const featured = failed ? [] : siteData.featured.slice(0, Math.max(wholeRows(siteData.featured.length, 3), wholeRows(siteData.featured.length, 4)))
const featuredIds = new Set(featured.map((o) => o.id))
const closingSoon = failed ? [] : siteData.closing_soon.filter((o) => !featuredIds.has(o.id))
const publicCollections = collections instanceof ApiError ? [] : collections.filter((c) => c.items.length > 0)
const recentOrgs =
  recent instanceof ApiError ? [] : [...new Set(recent.items.map((o) => o.organization.trim()).filter(Boolean))]
        .filter((name) => name.length <= 48)
        .slice(0, 5)

const audiences = [
  {
    slug: "startups",
    title: "Startups",
    body: "Accelerators, pitch competitions and equity-free grants for founders building in Ghana.",
    image: startups768,
  },
  {
    slug: "researchers",
    title: "Researchers",
    body: "Research grants, calls for proposals and fellowships, with eligibility laid out up front.",
    image: researchers768,
  },
  {
    slug: "students",
    title: "Students",
    body: "Scholarships, internships and exchanges at home and abroad, with what to prepare.",
    image: students768,
  },
]

const steps = [
  { title: "Track", body: "Save an opportunity and watch its deadline count down." },
  { title: "Plan", body: "Turn requirements into a checklist: transcripts, references, a budget." },
  { title: "Sync", body: "Send deadlines to your calendar and get reminded before they close." },
  { title: "Find more", body: "Members see new finds from our discovery agent first." },
]
---

<Base path="/" jsonLd={organizationLd(siteUrl())} heroOnForest>
  {
    announcement && (
      <div slot="banner" class="bg-sun-soft text-sun-ink">
        <p class="site-container m-0 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 py-2.5 text-center text-callout">
          <span>{announcement.text}</span>
          {announcement.link && (
            <a href={announcement.link} class="font-semibold text-sun-ink underline">
              Read more
            </a>
          )}
        </p>
      </div>
    )
  }

  <section aria-labelledby="hero-title" class="bg-forest text-on-forest">
    <div class="site-container pt-10 pb-10 md:pt-16">
      <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div>
          <h1 id="hero-title" class="m-0 type-title-1 text-on-forest md:type-hero">{heroTitle}</h1>
          <p class="m-0 mt-5 max-w-[50ch] text-lg leading-7 text-on-forest/85">{heroSubtitle}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={withBase("/opportunities")} class={buttonVariants({ variant: "primary", size: "lg" })}>Browse opportunities</a>
            <a
              href={registerUrl()}
              class={cn(buttonVariants({ variant: "quiet", size: "lg" }), "border-on-forest/40 text-on-forest hover:bg-on-forest/10")}
            >
              Create account
            </a>
          </div>
          <p class="m-0 mt-4 text-footnote text-on-forest/75">Free to browse. An account lets you track deadlines and plan each application.</p>
        </div>
        <div class="relative">
          <Illustration full={hero} small={hero768} eager />
          <span aria-hidden="true" class="absolute -bottom-4 -left-4 hidden rounded-full bg-surface p-1 shadow-elevation-2 md:block">
            <Countdown daysLeft={12} />
          </span>
        </div>
      </div>

      {
        recentOrgs.length > 0 && (
          <div class="mt-14 md:mt-20">
            <div class="flex items-center gap-6">
              <h2 class="m-0 shrink-0 text-callout font-medium text-on-forest/75">Recently added from</h2>
              <span aria-hidden="true" class="h-px flex-1 bg-on-forest/25" />
            </div>
            <ul class="m-0 mt-5 flex list-none flex-wrap items-center gap-x-12 gap-y-3 p-0">
              {recentOrgs.map((name, i) => (
                <li class={cn("font-display text-base font-semibold tracking-[-0.01em] text-on-forest/85 md:text-lg", i >= 3 && "hidden sm:list-item")}>
                  {name}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {failed && <ApiErrorSection />}

  <div class="pt-8 sm:pt-12">
    {
      featured.length > 0 && (
        <Panel
          id="featured"
          title="Picked by our editors"
          description="Open opportunities our team has checked against the official page this week."
          link={{ href: withBase("/opportunities"), label: "See all opportunities" }}
        >
          <CardGrid items={featured} rows />
        </Panel>
      )
    }

    {
      closingSoon.length > 0 && (
        <Panel
          id="closing-soon"
          title="There's still time"
          description="Deadlines in the next two weeks."
          tone="sun"
          link={{ href: withBase("/opportunities?closing_within=14"), label: "See everything closing soon" }}
        >
          <CardGrid items={closingSoon} rows />
        </Panel>
      )
    }

    <Panel
      id="who"
      title="Opportunities for every stage"
      description="Whether you're founding, researching or studying, start with what fits you."
      tone="forest"
    >
      <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-3">
        {
          audiences.map((a) => (
            <li class="min-w-0">
              <article class="group relative flex h-full flex-col rounded-lg bg-surface p-4 shadow-elevation-1 transition-[box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-elevation-2 motion-reduce:hover:translate-y-0">
                <img
                  src={a.image.src}
                  width={a.image.width}
                  height={a.image.height}
                  alt=""
                  loading="lazy"
                  class="block h-auto w-full rounded-md"
                />
                <div class="flex flex-1 flex-col gap-2 px-1 pt-4">
                  <h3 class="m-0 type-title-2 text-ink">
                    <a href={withBase(`/${a.slug}`)} class="text-ink no-underline after:absolute after:inset-0 after:rounded-lg after:content-['']">
                      {a.title}
                    </a>
                  </h3>
                  <p class="m-0 text-ink-secondary">{a.body}</p>
                  <span aria-hidden="true" class="mt-auto border-t border-separator pt-3 text-callout font-semibold text-link group-hover:underline">
                    See opportunities
                  </span>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </Panel>
  </div>

  <FeatureSplit id="how" title="From found to submitted, in one place" full={path} small={path768} tone="sun">
    <Fragment slot="chips">
      <span class="absolute top-4 left-4 rounded-full bg-surface p-1 shadow-elevation-2">
        <Countdown daysLeft={12} date="2026-11-21" />
      </span>
    </Fragment>
    <ol class="m-0 grid list-none gap-4 p-0 text-base leading-6">
      {
        steps.map((s, i) => (
          <li class="flex gap-4">
            <span
              aria-hidden="true"
              class={cn(
                "grid size-8 shrink-0 place-items-center rounded-full font-display text-base font-bold tabular-nums",
                i === 0 ? "bg-sun text-on-sun" : "bg-forest-soft text-link",
              )}
            >
              {i + 1}
            </span>
            <span>
              <span class="font-semibold text-ink">{s.title}.</span> {s.body}
            </span>
          </li>
        ))
      }
    </ol>
  </FeatureSplit>

  <FeatureSplit id="members" title="Members see new finds first" full={scanning} small={scanning} tone="forest" reverse>
    <Fragment slot="chips">
      <span class="absolute top-4 right-4 flex items-center gap-2 rounded-full bg-surface py-1.5 pr-3 pl-1.5 shadow-elevation-2">
        <Chip tone="sun">New</Chip>
        <span class="text-callout font-semibold text-ink">Found 2 days ago</span>
      </span>
    </Fragment>
    <p class="m-0">
      Our discovery agent searches funders' and universities' pages on a regular schedule. Members see what it finds first, before our editors
      bring it to this site, and can follow each application from saved to submitted.
    </p>
    <a slot="cta" href={registerUrl()} class={buttonVariants({ variant: "brand", size: "lg" })}>Create account</a>
    <a slot="cta" href={loginUrl()} class="px-2 font-semibold text-ink underline">Sign in</a>
  </FeatureSplit>

  {
    publicCollections.length > 0 && (
      <Panel
        id="collections"
        title="Lists our editors keep up to date"
        description="Hand-picked sets of opportunities around a theme or a deadline."
      >
        <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
          {publicCollections.map((c, i) => (
            <li class="min-w-0">
              <article class="group relative flex h-full flex-col rounded-lg bg-surface p-4 shadow-elevation-1 transition-[box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-elevation-2 motion-reduce:hover:translate-y-0">
                <div
                  class={cn(
                    "flex h-28 items-end rounded-md p-4",
                    ["bg-sun-soft text-sun-ink", "bg-forest-soft text-link", "bg-surface-sunk text-forest"][i % 3],
                  )}
                >
                  <span class="type-numeral">{c.items.length}</span>
                  <span class="ml-2 pb-1 text-callout font-semibold">open</span>
                </div>
                <div class="flex flex-1 flex-col gap-2 px-1 pt-4">
                  <h3 class="m-0 text-title-3 text-ink">
                    <a href={withBase(`/collections/${c.slug}`)} class="text-ink no-underline after:absolute after:inset-0 after:content-['']">
                      {c.title}
                    </a>
                  </h3>
                  {c.intro && <p class="m-0 line-clamp-3 text-callout text-ink-secondary">{c.intro}</p>}
                  <span aria-hidden="true" class="mt-auto inline-flex items-center gap-2 border-t border-separator pt-3 text-callout font-semibold text-ink group-hover:underline">
                    View {plural(c.items.length, "opportunity", "opportunities")}
                  </span>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </Panel>
    )
  }

  <section aria-labelledby="join" class="site-container pt-16 md:pt-20">
    <div class="grid items-center gap-10 md:grid-cols-2 lg:gap-16">
      <div>
        <h2 id="join" class="m-0 type-title-1 text-ink md:type-hero">Keep every deadline in view</h2>
        <p class="m-0 mt-4 max-w-[44ch] text-lg leading-7 text-ink-secondary">
          Track opportunities, plan what each application needs and get reminded before anything closes.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={registerUrl()} class={buttonVariants({ variant: "primary", size: "lg" })}>Create account</a>
          <span class="text-callout text-ink-secondary">It's free, and takes a minute</span>
        </div>
      </div>
      <div class="relative">
        <Illustration full={community} small={community768} />
      </div>
    </div>
  </section>
</Base>
