---
import { LinkEmptyState } from "../components/States"
import offline from "@blesser/ui/illustrations/spot-offline.webp"
import Base from "../layouts/Base.astro"
---

<Base title="Something went wrong" noindex>
  <section class="site-container py-16">
    <LinkEmptyState
      error
      illustration={offline.src}
      title="This page didn't load"
      description="Something went wrong on our side. Try again in a minute, or start from the opportunities list."
      actions={[
        { href: Astro.url.pathname, label: "Try again", primary: true },
        { href: "/opportunities", label: "Browse opportunities" },
      ]}
    />
  </section>
</Base>
