---
import { LinkEmptyState } from "./States"
import { withBase } from "../lib/config"

interface Props {
  title?: string
  description?: string
}
const {
  title = "We couldn't find that page",
  description = "The link may be old, or the page may have moved. Browse what's open now instead.",
} = Astro.props
---

<section class="site-container py-16">
  <LinkEmptyState
    title={title}
    description={description}
    actions={[
      { href: withBase("/opportunities"), label: "Browse opportunities", primary: true },
      { href: withBase("/"), label: "Go home" },
    ]}
  />
</section>
