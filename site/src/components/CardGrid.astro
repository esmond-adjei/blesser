---
import { cn } from "@blesser/ui"
import { SiteCard } from "./SiteCard"
import type { PublicOpportunity } from "../lib/api"
import { registerUrl } from "../lib/config"
import { PAGE_SIZE, wholeRows } from "../lib/listing"

interface Props {
  items: PublicOpportunity[]
  /** Show whole rows only: up to two rows of three, or of four on wide screens. */
  rows?: boolean
  /** Render every item with the data ClientListing filters and pages on. */
  listing?: boolean
}
const { items, rows = false, listing = false } = Astro.props
const three = rows ? wholeRows(items.length, 3) : items.length
const four = rows ? wholeRows(items.length, 4) : items.length
---

<ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
  {
    items.slice(0, Math.max(three, four)).map((opp, i) => (
      <li
        class={cn("min-w-0", i >= three && "hidden 2xl:list-item", i >= four && "2xl:hidden")}
        {...(listing && {
          hidden: i >= PAGE_SIZE,
          "data-opp": "",
          "data-category": opp.category,
          "data-kind": opp.kind,
          "data-deadline": opp.rolling ? "" : (opp.deadline_date ?? ""),
          "data-published": opp.published_at ?? "",
          "data-text": [opp.title, opp.organization, opp.summary, opp.benefits, ...opp.tags].join(" ").toLowerCase(),
        })}
      >
        <SiteCard opp={opp} trackUrl={registerUrl(opp.slug)} />
      </li>
    ))
  }
</ul>
