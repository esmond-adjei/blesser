---
import type { ImageMetadata } from "astro"
import { cn } from "@blesser/ui"

interface Props {
  eyebrow?: string
  title: string
  description?: string
  tone?: "sunk" | "sun" | "forest"
  illustration?: ImageMetadata
  big?: boolean
}
const { eyebrow, title, description, tone = "sunk", illustration, big = false } = Astro.props
const tint = { sunk: "bg-surface-sunk", sun: "bg-sun-soft", forest: "bg-forest-soft" }[tone]
---

<div class="site-container pt-6 sm:pt-8">
  <div class={cn("relative overflow-hidden rounded-xl px-5 py-8 sm:px-10 sm:py-12", tint)}>
    <span aria-hidden="true" class="absolute -top-10 -right-10 hidden size-32 rounded-full bg-sun md:block"></span>
    <div class={cn("relative grid items-center gap-8", illustration && "md:grid-cols-[1.15fr_1fr] lg:gap-14")}>
      <div>
        <slot name="above" />
        {eyebrow && <p class="m-0 mb-3 eyebrow text-ink">{eyebrow}</p>}
        <h1 class={cn("m-0 type-title-1 text-ink", big && "md:type-hero")}><slot name="title">{title}</slot></h1>
        {description && <p class="m-0 mt-4 max-w-[56ch] text-lg leading-7 whitespace-pre-line text-ink-secondary">{description}</p>}
        <slot name="meta" />
      </div>
      {
        illustration && (
          <img
            src={illustration.src}
            width={illustration.width}
            height={illustration.height}
            alt=""
            fetchpriority="high"
            class="relative block h-auto w-full rounded-lg"
          />
        )
      }
    </div>
    <slot />
  </div>
</div>
