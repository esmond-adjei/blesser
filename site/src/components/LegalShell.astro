---
import Base from "../layouts/Base.astro"

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
// Keep in step with the API TERMS_VERSION and webapp Legal.tsx.
const TERMS_VERSION = "2026-11-07"
---

<Base title={title} description={description}>
  <div class="site-container py-10">
    <h1 class="m-0 type-title-1 text-ink">{title}</h1>
    <p class="m-0 mt-2 text-footnote text-ink-tertiary">Version {TERMS_VERSION}</p>
    <div class="rich-text mt-8 text-ink">
      <slot />
    </div>
  </div>
</Base>
