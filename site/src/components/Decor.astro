---
import { cn } from "@blesser/ui"

interface Props {
  kind: "sun" | "steps" | "spot"
  src?: string
  class?: string
}
const { kind, src, class: className } = Astro.props
---

<div aria-hidden="true" class={cn("pointer-events-none absolute hidden select-none lg:block", className)}>
  {kind === "sun" && <span class="block size-full rounded-full bg-sun" />}
  {
    kind === "steps" && (
      <span class="flex flex-col items-end gap-1.5">
        <span class="block h-4 w-8 rounded-full bg-bloom" />
        <span class="block h-4 w-14 rounded-full bg-surface shadow-elevation-1" />
        <span class="block h-4 w-20 rounded-full bg-forest" />
      </span>
    )
  }
  {kind === "spot" && src && <img src={src} alt="" class="block h-auto w-full" loading="lazy" />}
</div>
