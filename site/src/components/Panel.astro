---
import { cn } from "@blesser/ui"

interface Props {
  id: string
  title: string
  description?: string
  link?: { href: string; label: string }
  tone?: "sunk" | "sun" | "forest"
  class?: string
}
const { id, title, description, link, tone = "sunk", class: className } = Astro.props
const tint = { sunk: "bg-surface-sunk", sun: "bg-sun-soft", forest: "bg-forest-soft" }[tone]
---

<section aria-labelledby={id} class={cn("site-container py-6 sm:py-8", className)}>
  <div class={cn("rounded-xl px-4 py-10 sm:px-8 md:py-14 lg:px-12", tint)}>
    <header class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-10">
      <div class="max-w-[640px]">
        <h2 id={id} class="m-0 type-title-1 text-ink">{title}</h2>
        {description && <p class="m-0 mt-3 text-lg leading-7 text-ink-secondary">{description}</p>}
      </div>
      {
        link && (
          <a href={link.href} class="shrink-0 font-semibold text-link underline decoration-1 underline-offset-4 hover:decoration-2">
            {link.label}
          </a>
        )
      }
    </header>
    <slot />
  </div>
</section>
