---
import type { ImageMetadata } from "astro"
import { cn } from "@blesser/ui"

interface Props {
  full: ImageMetadata
  small: ImageMetadata
  sizes?: string
  eager?: boolean
  class?: string
}
const { full, small, sizes = "(min-width: 1024px) 760px, 100vw", eager = false, class: className } = Astro.props
---

<img
  src={small.src}
  srcset={`${small.src} ${small.width}w, ${full.src} ${full.width}w`}
  sizes={sizes}
  width={small.width}
  height={small.height}
  alt=""
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
  class={cn("block h-auto w-full rounded-xl", className)}
/>
