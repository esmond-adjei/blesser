---
import { Logo, Wordmark, buttonVariants, cn } from "@blesser/ui"
import { MenuIcon } from "./icons"
import { loginUrl, registerUrl, withBase } from "../lib/config"

const NAV = [
  { href: "/opportunities", label: "Opportunities" },
  { href: "/grants", label: "Grants" },
  { href: "/scholarships", label: "Scholarships" },
  { href: "/fellowships", label: "Fellowships" },
  { href: "/accelerators", label: "Accelerators" },
  { href: "/about", label: "About" },
].map((item) => ({ ...item, href: withBase(item.href) }))

interface Props {
  onForest?: boolean
}
const { onForest = false } = Astro.props
const path = Astro.url.pathname
const current = (href: string) => path === href || path.startsWith(`${href}/`)
---

<header class={onForest ? "bg-forest text-on-forest" : "border-b border-separator bg-canvas"}>
  <div class="site-container flex h-16 items-center gap-6">
    <a href={withBase("/")} class={cn("flex items-center gap-1 rounded-full no-underline", onForest && "[--logo-ink:#ffffff]")} aria-label="Blesser home">
      <Logo title="" className="size-8" motion="sunrise" />
      <Wordmark motion="sunrise" />
    </a>
    <nav aria-label="Main" class="hidden flex-1 lg:block">
      <ul class="m-0 flex list-none items-center gap-1 p-0">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current(item.href) ? "page" : undefined}
                class={cn(
                  "relative inline-flex h-control-md items-center rounded-full px-3 text-callout no-underline transition-colors duration-160",
                  onForest
                    ? "text-on-forest/80 hover:bg-on-forest/10 hover:text-on-forest"
                    : "text-ink-secondary hover:bg-highlight hover:text-ink",
                  current(item.href) &&
                    cn(onForest ? "text-on-forest" : "text-ink", "after:absolute after:inset-x-3 after:bottom-1 after:h-0.5 after:rounded-full after:bg-sun"),
                )}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <a
        href={loginUrl()}
        class={cn(buttonVariants({ variant: "quiet", size: "md" }), "hidden sm:inline-flex", onForest && "text-on-forest hover:bg-on-forest/10")}
      >
        Sign in
      </a>
      <a
        href={registerUrl()}
        class={cn(buttonVariants({ variant: onForest ? "secondary" : "brand", size: "md" }), "hidden sm:inline-flex", onForest && "border-transparent")}
      >
        Create account
      </a>
      <details class="group relative lg:hidden">
        <summary
          class={cn(
            buttonVariants({ variant: "quiet", size: "md", iconOnly: true }),
            "list-none [&::-webkit-details-marker]:hidden",
            onForest && "text-on-forest hover:bg-on-forest/10",
          )}
          aria-label="Menu"
        >
          <MenuIcon />
        </summary>
        <nav
          aria-label="Main"
          class="absolute right-0 z-40 mt-2 w-64 rounded-lg border border-separator bg-surface-raised p-2 text-ink shadow-elevation-3"
        >
          <ul class="m-0 list-none p-0">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={current(item.href) ? "page" : undefined}
                    class="flex h-control-md items-center rounded-sm px-3 text-ink no-underline hover:bg-highlight aria-[current=page]:font-semibold"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="mt-2 flex flex-col gap-2 border-t border-separator pt-3 sm:hidden">
            <a href={registerUrl()} class={buttonVariants({ variant: "brand", size: "lg" })}>Create account</a>
            <a href={loginUrl()} class={buttonVariants({ variant: "secondary", size: "lg" })}>Sign in</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
