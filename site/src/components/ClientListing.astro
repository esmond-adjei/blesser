---
import { buttonVariants, cn } from "@blesser/ui"
import CardGrid from "./CardGrid.astro"
import Pagination from "./Pagination.astro"
import { LinkEmptyState } from "./States"
import type { PublicOpportunity } from "../lib/api"
import { PAGE_SIZE } from "../lib/listing"

interface Props {
  items: PublicOpportunity[]
  /** Apply the /opportunities query filters (q, category, kind, closing_within, sort). */
  filters?: boolean
  empty: { title: string; description: string; actions: { href: string; label: string }[] }
}
const { items, filters = false, empty } = Astro.props
const pill = (active: boolean) => cn(buttonVariants({ variant: active ? "brand" : "quiet", size: "md" }), "min-w-control-md tabular-nums")
---

<div
  data-listing={filters ? "filter" : "page"}
  data-page-size={PAGE_SIZE}
  data-pill={pill(false)}
  data-pill-active={pill(true)}
  data-step={buttonVariants({ variant: "secondary", size: "md" })}
>
  <CardGrid items={items} listing />
  <div data-empty hidden>
    <LinkEmptyState className="mt-8" title={empty.title} description={empty.description} actions={empty.actions} />
  </div>
  <div data-pages>
    <Pagination total={items.length} page={1} pageSize={PAGE_SIZE} />
  </div>
</div>

<script>
  // The static build has no server to read the query string, so filtering and paging happen here.
  const DAY = 86_400_000
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`)

  for (const root of document.querySelectorAll<HTMLElement>("[data-listing]")) {
    const params = new URLSearchParams(location.search)
    const filtering = root.dataset.listing === "filter"
    const get = (k: string) => (filtering ? (params.get(k) ?? "").trim() : "")
    const words = get("q").toLowerCase().split(/\s+/).filter(Boolean)
    const category = get("category")
    const kind = get("kind")
    const within = Number(get("closing_within")) || 0
    const today = new Date().toISOString().slice(0, 10)
    const daysTo = (d: string) => Math.round((Date.parse(d) - Date.parse(today)) / DAY)

    const form = document.querySelector<HTMLFormElement>("form[role=search]")
    if (filtering && form)
      for (const [k, v] of params) {
        const field = form.elements.namedItem(k)
        if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = v
      }

    const list = root.querySelector("ul")!
    const all = [...list.querySelectorAll<HTMLElement>("[data-opp]")]
    const shown = all.filter(({ dataset: d }) => {
      if (d.deadline && d.deadline < today) return false
      if (category && d.category !== category) return false
      if (kind && d.kind !== kind) return false
      if (within && (!d.deadline || daysTo(d.deadline) > within)) return false
      return words.every((w) => d.text!.includes(w))
    })
    if (get("sort") === "new") shown.sort((a, b) => b.dataset.published!.localeCompare(a.dataset.published!))

    const size = Number(root.dataset.pageSize)
    const pages = Math.max(1, Math.ceil(shown.length / size))
    const page = Math.min(Math.max(1, Number.parseInt(params.get("page") ?? "1", 10) || 1), pages)
    for (const li of all) li.hidden = true
    for (const li of shown.slice((page - 1) * size, page * size)) {
      li.hidden = false
      list.append(li)
    }

    const n = shown.length
    for (const el of document.querySelectorAll("[data-count]")) el.textContent = `${n.toLocaleString("en-GB")} ${n === 1 ? "opportunity" : "opportunities"}`
    for (const el of document.querySelectorAll("[data-page-note]")) el.textContent = page > 1 ? ` · page ${page}` : ""
    root.querySelector<HTMLElement>("[data-empty]")!.hidden = n > 0

    const href = (p: number) => {
      const q = new URLSearchParams(params)
      if (p <= 1) q.delete("page")
      else q.set("page", String(p))
      const s = q.toString()
      return esc(`${location.pathname}${s ? `?${s}` : ""}`)
    }
    const { pill, pillActive, step } = root.dataset
    const nums = [...new Set([1, page - 1, page, page + 1, pages])].filter((p) => p >= 1 && p <= pages).sort((a, b) => a - b)
    const links = nums.map(
      (p, i) =>
        (i > 0 && p - nums[i - 1]! > 1 ? '<span class="px-1 text-ink-tertiary" aria-hidden="true">…</span>' : "") +
        `<a href="${href(p)}"${p === page ? ' aria-current="page"' : ""} class="${p === page ? pillActive : pill}"><span class="sr-only">Page </span>${p}</a>`,
    )
    root.querySelector("[data-pages]")!.innerHTML =
      pages > 1
        ? `<nav aria-label="Pages" class="mt-10 flex flex-wrap items-center justify-center gap-1">${
            (page > 1 ? `<a href="${href(page - 1)}" rel="prev" class="${step}">Previous</a>` : "") +
            links.join("") +
            (page < pages ? `<a href="${href(page + 1)}" rel="next" class="${step}">Next</a>` : "")
          }</nav>`
        : ""
  }
</script>
