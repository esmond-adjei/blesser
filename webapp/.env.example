# Graduator client env
# Point at a remote backend; leave blank for same-origin (dev proxy -> localhost:8000).
VITE_API_URL=

# The marketing site. Anonymous visitors on the app's root are sent here.
# Leave blank in local dev and the app offers sign-in instead.
VITE_SITE_URL=

# Contact address shown on the privacy and terms pages.
VITE_CONTACT_EMAIL=
