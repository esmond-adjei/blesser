# Build-time configuration for the marketing site. Public values are baked
# into the static HTML, so nothing secret belongs here.
#
# Placeholders until the real domains are live.
PUBLIC_SITE_URL=https://graduator.example
PUBLIC_APP_URL=https://app.graduator.example

# Operator contact shown on the legal pages (privacy requests, removals).
PUBLIC_CONTACT_EMAIL=hello@graduator.example

# Public backend API base for live pricing. Defaults to PUBLIC_APP_URL/api.
# Allow PUBLIC_SITE_URL in the backend CORS_ORIGINS. No credentials are sent.
PUBLIC_API_URL=https://app.graduator.example/api

# Waitlist mode: calls to action collect emails instead of opening sign-up,
# and pricing is hidden. Set to "off" to reopen registration.
PUBLIC_WAITLIST_MODE=on
# Web3Forms endpoint and access key that receive waitlist sign-ups.
PUBLIC_WAITLIST_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_WAITLIST_ACCESS_KEY=<web3forms-access-key>
