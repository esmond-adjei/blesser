---
import Base from "../layouts/Base.astro"
import Faq from "../components/sections/Faq.astro"
import { ArrowRight } from "@lucide/astro"
import { REGISTER_URL, WAITLIST_MODE } from "../lib/site"
import WaitlistForm from "../components/WaitlistForm.astro"
import type { FaqItem } from "../lib/faq"
import Pricing from "../components/sections/Pricing.astro"

const description = "Graduator pricing: Free, Plus, Season Pass and Pro. Pay by card or mobile money; no plan renews on its own."

const questions: FaqItem[] = [
  {
    question: "How do I pay?",
    answer: "By card, or by mobile money on MTN, Telecel or AirtelTigo. Prices are in US dollars and charged in Ghana cedis at the rate shown at checkout. Payments are processed by Paystack.",
  },
  {
    question: "Does my plan renew automatically?",
    answer: "No. A monthly plan runs for 30 days and a yearly one for 365. Paying again before it ends adds the new period on top. If you don't, your account moves to Free and keeps everything you saved.",
  },
  {
    question: "What is a professor credit?",
    answer: "A credit pays for researching one professor with the system model. Researching a professor with your own model uses half a credit. Credits are charged when professor research is scheduled, whether or not the professor becomes a match.",
  },
  {
    question: "What happens when I run out of credits?",
    answer: "Your saved research stays in your account. Professor research waits until credits are available. Monthly allowances reset on the first of the month, and you can buy additional credits; they never expire.",
  },
  {
    question: "How does the Season Pass work?",
    answer: "The Season Pass includes a fixed period of plan access and professor credits for one payment. See the current allowances above. The included credits do not expire, even after the pass ends. Gradis messages have a monthly allowance.",
  },
  {
    question: "Can I use my own AI model?",
    answer: "Yes, on every plan. You can use your own provider key or a compatible server. Professor research with your own model uses half a credit; your model provider may charge you separately.",
  },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
}
---

<Base title="Pricing" description={description} route="/pricing" schema={WAITLIST_MODE ? undefined : schema}>
  {
    WAITLIST_MODE && (
      <>
        <section class="mx-auto max-w-3xl px-4 pt-14 text-center sm:px-6 sm:pt-20">
          <p class="type-eyebrow text-primary">Pricing</p>
          <h1 class="mx-auto mt-3 max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl">
            Plans arrive when we open.
          </h1>
          <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-muted-foreground">
            Graduator is opening to new applicants soon, with a free plan to start. Join the waitlist and we'll tell
            you when it's your turn.
          </p>
        </section>
        <section class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
          <div class="g-card sm:p-8">
            <WaitlistForm id="waitlist-pricing" />
          </div>
        </section>
      </>
    )
  }
  {
    !WAITLIST_MODE && (
      <>
  <section class="mx-auto max-w-site px-4 pt-14 text-center sm:px-6 sm:pt-20">
    <p class="type-eyebrow text-primary">Pricing</p>
    <h1 class="mx-auto mt-3 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">Research at your own pace.</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
      Start with a shortlist, or make room for a full application season. Choose the amount of research that fits your plans.
    </p>
  </section>

  <Pricing compare>

  <section class="mx-auto max-w-5xl px-4 pt-20 sm:px-6">
    <div class="grid gap-8 md:grid-cols-2 md:gap-16">
      <div>
        <p class="type-eyebrow text-primary">Professor credits</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">Know what your research uses.</h2>
      </div>
      <div class="space-y-4 text-sm leading-relaxed text-muted-foreground">
        <p>One credit researches one professor with the system model. Use your own model and that research costs half a credit. Credits count professors researched, including those who aren't a match.</p>
        <p>Monthly credits and Gradis messages reset on the first of the month. Need more before then? <span data-pricing-top-up>View current top-up options in the app.</span></p>
        <p data-pricing-season></p>
      </div>
    </div>
  </section>

  </Pricing>

  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Questions about plans</h2>
    <div class="g-list mt-8 px-6"><Faq questions={questions} /></div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-24 text-center sm:px-6">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Start your research.</h2>
    <p class="mt-3 text-muted-foreground">Start with Free. No card needed.</p>
    <a href={REGISTER_URL} class="g-btn g-btn--primary g-btn--capsule mt-8">Create your account <ArrowRight class="size-4" aria-hidden="true" /></a>
  </section>
      </>
    )
  }
</Base>
