---
import { path } from "../../lib/site"
import { ChevronDown } from "@lucide/astro"
import { FAQ, type FaqItem } from "../../lib/faq"

interface Props {
  /** Show only the first N questions. */
  limit?: number
  /** A page's own questions, in place of the shared list. */
  questions?: FaqItem[]
}

const { limit, questions = FAQ } = Astro.props
const items = limit ? questions.slice(0, limit) : questions
---

<ul class="divide-y divide-border">
  {
    items.map((item) => (
      <li>
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-base font-medium [&::-webkit-details-marker]:hidden">
            {item.question}
            <ChevronDown class="mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
            <p>{item.answer}</p>
            {item.links && (
              <p class="mt-2 text-sm">
                {item.links.map((link) => (
                  <a href={path(link.href)} class="text-primary hover:underline">
                    {link.label}
                  </a>
                ))}
              </p>
            )}
          </div>
        </details>
      </li>
    ))
  }
</ul>
