---
import { ArrowRight } from "@lucide/astro"
import FilmPlayer from "../FilmPlayer.astro"
import { REGISTER_URL, WAITLIST_MODE, path } from "../../lib/site"
---

<section>
  <div class="mx-auto max-w-site px-4 pt-20 text-center sm:px-6 sm:pt-28">
    <p class="type-eyebrow">For PhD and master's applicants</p>
    <h1 class="type-hero mx-auto mt-5 max-w-5xl max-sm:text-[56px] max-sm:leading-[1.02] max-[480px]:text-[44px]">
      Find the professor,<br />not just the <em>programme.</em>
    </h1>
    <p class="type-lead mx-auto mt-6 max-w-2xl text-[var(--label-secondary)]">
      Graduator reads the papers of every professor in the programmes you care about, ranks who fits your research,
      and drafts a first email that cites their work. You decide who to write to.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={REGISTER_URL} class="g-btn g-btn--primary g-btn--capsule g-btn--lg">{WAITLIST_MODE ? "Join the waitlist" : "Start free"} <ArrowRight class="size-4" aria-hidden="true" /></a>
      {
        WAITLIST_MODE ? (
          <a href={path("/#how")} class="g-btn g-btn--gray g-btn--capsule g-btn--lg">How it works</a>
        ) : (
          <a href={path("/pricing")} class="g-btn g-btn--gray g-btn--capsule g-btn--lg">See pricing</a>
        )
      }
    </div>
    <p class="mt-4 type-caption">
      {WAITLIST_MODE ? "Opening to new applicants soon. Join the waitlist to be first in." : "40 professors free in your first month. No card needed."}
    </p>
    <!-- Decoders tint the film's canvas slightly; feathered edges keep it from showing as a box. -->
    <FilmPlayer id="hero-film" class="mt-12 [&_video]:mask-x-from-98% [&_video]:mask-x-to-100% [&_video]:mask-y-from-97% [&_video]:mask-y-to-100%" />
  </div>
</section>
