---
/**
 * The product film: one run, from a question to an approved email, in 38
 * seconds. Rendered by scripts/build-video.mjs from scripts/video/scene.html.
 *
 * The files load only as the player nears the viewport, so the first paint
 * doesn't wait on them. It plays muted and loops, with a pause control; with
 * reduced motion it waits on the poster until someone presses play.
 */
import { Pause, Play } from "@lucide/astro"
import { path } from "../lib/site"

interface Props {
  class?: string
  /** Distinguishes the caption's id when a page has more than one player. */
  id?: string
}
const { class: className = "", id = "film" } = Astro.props
const descriptionId = `${id}-description`
---

<figure class:list={["relative", className]} data-film-player>
  <video
    class="block aspect-video w-full"
    muted
    loop
    playsinline
    preload="none"
    poster={path("/media/graduator-film-poster.jpg")}
    aria-label="A Graduator run, from a research question to an approved email"
    aria-describedby={descriptionId}
    data-film
  >
    <source data-src={path("/media/graduator-film.webm")} type="video/webm" />
    <source data-src={path("/media/graduator-film.mp4")} type="video/mp4" />
  </video>
  <button
    type="button"
    class="film-toggle absolute -bottom-0 left-1/2 inline-flex size-9 cursor-pointer items-center justify-center rounded-full bg-[var(--material)] text-[var(--label)] shadow-[var(--elevation-1)] backdrop-blur-md transition-colors hover:bg-[var(--surface)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus)]"
    aria-label="Play the film"
    data-film-toggle
  >
    <Play class="film-icon-play size-4" aria-hidden="true" />
    <Pause class="film-icon-pause size-4" aria-hidden="true" />
  </button>
  <figcaption id={descriptionId} class="sr-only">
    A student asks for a PhD in robotics in Europe, on reinforcement learning for agile legged robots. Gradis plans the
    search: it finds programmes, reads faculty pages at six schools, pulls each professor's publications and scores 42
    professors. A dossier lists the top five by fit, each with the paper behind the score; opening a citation shows the
    paper's journal, year and authors. The student then asks for an email to the best match. Gradis reads the
    professor's latest papers and drafts an email that cites the closest one. The student approves it, and it waits in
    the outbox. The run ends on the outbox, the dossier and the applications tracker.
  </figcaption>
</figure>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches

  for (const player of document.querySelectorAll<HTMLElement>("[data-film-player]")) {
    const video = player.querySelector<HTMLVideoElement>("[data-film]")
    const toggle = player.querySelector<HTMLButtonElement>("[data-film-toggle]")
    if (!video || !toggle) continue

    let loaded = false
    // Paused by the visitor: scrolling back into view must not restart it.
    let held = still

    const load = () => {
      if (loaded) return
      loaded = true
      for (const source of video.querySelectorAll<HTMLSourceElement>("source[data-src]")) {
        source.src = source.dataset.src!
      }
      video.load()
    }
    const sync = () => {
      const playing = !video.paused
      toggle.dataset.playing = String(playing)
      toggle.setAttribute("aria-label", playing ? "Pause the film" : "Play the film")
    }
    const play = () => {
      load()
      video.play().catch(() => {})
    }

    video.addEventListener("play", sync)
    video.addEventListener("pause", sync)
    toggle.addEventListener("click", () => {
      if (video.paused) {
        held = false
        play()
      } else {
        held = true
        video.pause()
      }
    })

    // Fetch a little before it scrolls in; play only while it's on screen.
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!held) play()
        } else if (!video.paused) {
          video.pause()
        }
      },
      { rootMargin: "200px 0px" },
    ).observe(video)
    sync()
  }
</script>
