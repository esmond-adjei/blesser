---
import { Menu, X } from "@lucide/astro"
import { LOGIN_URL, REGISTER_URL, WAITLIST_MODE, path } from "../lib/site"
import Logo from "./Logo.astro"

const nav = [
  { href: "/#how", label: "How it works" },
  { href: "/pricing", label: "Pricing" },
  { href: "/faq", label: "FAQ" },
].filter((item) => !(WAITLIST_MODE && item.href === "/pricing"))
---

<header data-site-header class="sticky top-0 z-50 border-b border-[var(--separator)] bg-[var(--material)] backdrop-blur-[var(--blur-thin)]">
  <div class="relative mx-auto flex h-16 max-w-site items-center gap-3 px-4 sm:px-6">
    <a href={path("/")} class="flex items-center gap-2" aria-label="Graduator home">
      <Logo class="size-8" />
      <span class="text-lg font-bold tracking-tight">Graduator</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={path(item.href)}
            class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <a href={LOGIN_URL} class="hidden rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:inline-flex">Sign in</a>
      <a
        href={REGISTER_URL}
        class="g-btn g-btn--primary g-btn--capsule"
      >
        {WAITLIST_MODE ? "Join waitlist" : "Start free"}
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex size-9 items-center justify-center rounded-md border border-border text-foreground md:hidden"
      >
        <span class="sr-only">Menu</span>
        <Menu class="size-5" data-menu-open />
        <X class="hidden size-5" data-menu-close />
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="relative border-y border-border bg-background md:hidden">
    <nav class="mx-auto flex max-w-site flex-col gap-1 px-4 py-3" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={path(item.href)}
            class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground"
          >
            {item.label}
          </a>
        ))
      }
      <a href={LOGIN_URL} class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground">Sign in</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]")
  const menu = document.getElementById("mobile-menu")
  const openIcon = document.querySelector<SVGElement>("[data-menu-open]")
  const closeIcon = document.querySelector<SVGElement>("[data-menu-close]")

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true"
      toggle.setAttribute("aria-expanded", String(!open))
      menu.hidden = open
      openIcon?.classList.toggle("hidden", !open)
      closeIcon?.classList.toggle("hidden", open)
    })
  }
</script>
