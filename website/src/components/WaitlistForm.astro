---
/*
 * The waitlist sign-up. Posts to Web3Forms, which emails each entry to the
 * owner, so the static site still stores nothing itself.
 * A `?ref=` on the page URL (e.g. a QR code at an event) is recorded as the
 * source of the sign-up.
 */
import { ArrowRight } from "@lucide/astro"
import { WAITLIST_ACCESS_KEY, WAITLIST_ENDPOINT, path } from "../lib/site"

interface Props {
  /** Distinguishes several forms on one page. */
  id: string
  /** "surface" on the normal background, "brand" on the blue band. */
  tone?: "surface" | "brand"
}

const { id, tone = "surface" } = Astro.props
---

<div class:list={["waitlist", `waitlist--${tone}`]} data-waitlist>
  <form data-waitlist-form data-endpoint={WAITLIST_ENDPOINT} data-access-key={WAITLIST_ACCESS_KEY} novalidate>
    <div class="waitlist__grid">
      <div class="g-field">
        <label class="g-label" for={`${id}-name`}>Name</label>
        <input class="g-input" id={`${id}-name`} name="name" type="text" autocomplete="name" maxlength="120" placeholder="Ama Mensah" />
      </div>
      <div class="g-field" data-field="email">
        <label class="g-label" for={`${id}-email`}>Email</label>
        <input class="g-input" id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@example.com" />
        <p class="g-hint" data-error hidden>Enter a valid email address.</p>
      </div>
      <div class="g-field">
        <label class="g-label" for={`${id}-level`}>Applying for</label>
        <select class="g-input g-select" id={`${id}-level`} name="level">
          <option value="Master's">A master's</option>
          <option value="PhD">A PhD</option>
          <option value="Not sure yet">Not sure yet</option>
        </select>
      </div>
      <div class="g-field">
        <label class="g-label" for={`${id}-field`}>Field <span class="waitlist__optional">(optional)</span></label>
        <input class="g-input" id={`${id}-field`} name="field" type="text" maxlength="120" placeholder="e.g. Robotics, Public health" />
      </div>
    </div>

    <!-- Spam trap: people never see it, bots fill it in. -->
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="waitlist__trap" aria-hidden="true" />

    <div class="waitlist__foot">
      <button type="submit" class:list={["g-btn g-btn--xl", tone === "brand" ? "g-btn--on-brand" : "g-btn--primary"]} data-waitlist-submit>
        Join the waitlist <ArrowRight class="size-4" />
      </button>
      <p class="waitlist__note">We'll only email you about Graduator opening. No spam.</p>
    </div>
    <p class="waitlist__status" role="status" aria-live="polite" data-waitlist-status></p>
  </form>

  <div class="waitlist__done" data-waitlist-done hidden>
    <img src={path("/mascot/happy.webp")} alt="" width="96" height="96" />
    <p class="waitlist__done-title">You're on the list.</p>
    <p class="waitlist__done-body">We'll email you as soon as Graduator opens. Thanks for being early.</p>
  </div>
</div>

<style>
  .waitlist { text-align: left; }
  .waitlist__grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .waitlist__grid { grid-template-columns: 1fr 1fr; } }
  .waitlist__optional { color: var(--label-tertiary); font-weight: 400; }
  .waitlist .g-select { appearance: auto; }
  .waitlist__trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .waitlist__foot { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-top: 1.5rem; }
  .waitlist__note { margin: 0; font: 400 13px/18px var(--font-sans); color: var(--label-secondary); }
  .waitlist__status { margin: .75rem 0 0; font: 500 14px/20px var(--font-sans); color: var(--critical); }
  .waitlist__status:empty { display: none; }
  .waitlist__done { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .5rem; padding: 1rem 0; }
  .waitlist__done img { height: 96px; width: auto; }
  .waitlist__done-title { margin: 0; font: 600 22px/28px var(--font-sans); letter-spacing: -0.015em; }
  .waitlist__done-body { margin: 0; max-width: 40ch; color: var(--label-secondary); }
  button[data-waitlist-submit]:disabled { opacity: .65; cursor: wait; }

  /* On the blue band: labels and notes switch to the on-brand colours. */
  .waitlist--brand .g-label,
  .waitlist--brand .waitlist__done-title { color: var(--on-brand); }
  .waitlist--brand .waitlist__note,
  .waitlist--brand .waitlist__optional,
  .waitlist--brand .waitlist__done-body { color: var(--on-brand-secondary); }
  .waitlist--brand .waitlist__status { color: var(--on-brand); }
</style>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

  function source(): string {
    const ref = new URLSearchParams(window.location.search).get("ref")?.trim()
    return ref ? ref.slice(0, 60) : "website"
  }

  document.querySelectorAll<HTMLElement>("[data-waitlist]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-waitlist-form]")
    const done = root.querySelector<HTMLElement>("[data-waitlist-done]")
    const status = root.querySelector<HTMLElement>("[data-waitlist-status]")
    const submit = root.querySelector<HTMLButtonElement>("[data-waitlist-submit]")
    const emailField = root.querySelector<HTMLElement>('[data-field="email"]')
    const emailError = emailField?.querySelector<HTMLElement>("[data-error]")
    if (!form || !done || !status || !submit) return

    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      status.textContent = ""
      const data = new FormData(form)

      // A filled-in trap means a bot: pretend it worked and send nothing.
      if (data.get("botcheck")) {
        form.hidden = true
        done.hidden = false
        return
      }

      const email = String(data.get("email") ?? "").trim()
      const valid = EMAIL.test(email)
      emailField?.classList.toggle("g-field--error", !valid)
      if (emailError) emailError.hidden = valid
      if (!valid) {
        form.querySelector<HTMLInputElement>('input[name="email"]')?.focus()
        return
      }

      const ref = source()
      const payload = {
        access_key: form.dataset.accessKey ?? "",
        subject: `Graduator waitlist: ${email} (${ref})`,
        from_name: "Graduator waitlist",
        name: String(data.get("name") ?? "").trim() || "(not given)",
        email,
        level: String(data.get("level") ?? ""),
        field: String(data.get("field") ?? "").trim() || "(not given)",
        source: ref,
        page: window.location.pathname,
      }

      submit.disabled = true
      try {
        const response = await fetch(form.dataset.endpoint ?? "", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        })
        const result = (await response.json().catch(() => ({}))) as { success?: string | boolean; message?: string }
        if (!response.ok || String(result.success) !== "true") {
          // Surface the service's reason (e.g. activation pending) instead of a generic error.
          console.error("Waitlist sign-up rejected", response.status, result)
          status.textContent = result.message
            ? `That didn't go through: ${result.message}`
            : `That didn't go through (error ${response.status}). Please try again.`
          return
        }
        form.hidden = true
        done.hidden = false
      } catch (error) {
        console.error("Waitlist sign-up failed", error)
        status.textContent = "That didn't go through. Check your connection and try again."
      } finally {
        submit.disabled = false
      }
    })
  })
</script>
